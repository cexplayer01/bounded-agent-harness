{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-harness/autonomous-floor.v1.schema.json",
  "title": "USB autonomous continuation floor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "project", "goal", "allowedEffects", "forbiddenEffects", "requiredReviewRoles", "maxCostUnits", "timeoutPolicy", "authorityMode"],
  "properties": {
    "format": { "const": "usb.autonomous-floor.v1" },
    "version": { "const": 1 },
    "project": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$" },
    "goal": { "type": "string", "minLength": 1 },
    "allowedEffects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "forbiddenEffects": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "requiredReviewRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["contract", "domain", "consistency", "reconciliation", "floor", "execution"] } },
    "maxCostUnits": { "type": "integer", "exclusiveMinimum": 0 },
    "timeoutPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forkAfterMinutes", "localOnly"],
      "properties": {
        "forkAfterMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "localOnly": { "type": "boolean" }
      }
    },
    "authorityMode": { "const": "NARROW_ONLY" }
  }
}
