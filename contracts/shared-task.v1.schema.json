{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedagentharness.com/contracts/shared-task.v1.schema.json",
  "title": "Bounded Agent Harness shared task",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "taskId", "createdAt", "createdBy", "assignedTo", "repository", "objective", "allowedPaths", "forbiddenActions", "acceptance", "expectedOutputs", "externalEffect", "taskDigest"],
  "properties": {
    "format": { "const": "agent-harness.shared-task.v1" },
    "version": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,40}$" },
    "assignedTo": { "type": "string", "pattern": "^(\\*|[a-z0-9][a-z0-9._-]{1,40})$" },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "url", "ref", "baseCommit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "objective": { "type": "string", "minLength": 1 },
    "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "forbiddenActions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "expectedOutputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "externalEffect": { "enum": ["NONE", "DRAFT_ONLY", "EXPLICIT_GO_REQUIRED"] },
    "taskDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
