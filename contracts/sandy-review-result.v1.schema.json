{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-harness/sandy-review-result.v1.schema.json",
  "title": "Optional Sandy review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "status", "reviewerId", "authority", "scope", "findings"],
  "properties": {
    "format": { "const": "agent-harness.sandy-review.v1" },
    "version": { "const": 1 },
    "status": { "enum": ["RECEIVED", "UNAVAILABLE"] },
    "reviewerId": { "const": "sandy-ux-reviewer" },
    "authority": { "const": "READ_ONLY_REVIEW" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "maxLines", "workflowDigest"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1 } },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 300 },
        "workflowDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "summary", "evidence", "recommendation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$" },
          "severity": { "enum": ["info", "low", "medium", "high"] },
          "category": { "enum": ["visual", "ux", "consistency"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "recommendation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "receivedAt": { "type": "string", "format": "date-time" }
  }
}
