{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-harness/specialist-profile.v1.schema.json",
  "title": "Agent Harness Specialist Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "description", "strengths", "limitations", "capabilities", "authority", "adapter", "evidence"],
  "properties": {
    "id": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "authority": { "type": "array", "items": { "type": "string" } },
    "adapter": { "type": "string" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedRuns", "acceptedOutputs", "rejectedOutputs"],
      "properties": {
        "completedRuns": { "type": "integer", "minimum": 0 },
        "acceptedOutputs": { "type": "integer", "minimum": 0 },
        "rejectedOutputs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
