{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedagentharness.com/contracts/context-packet.v1.schema.json",
  "title": "Bounded Agent Harness context packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "stable", "delta", "references", "omitted", "stableDigest", "deltaDigest", "digest"],
  "properties": {
    "format": { "const": "agent-harness.context-packet.v1" },
    "version": { "const": 1 },
    "stable": { "type": "object" },
    "delta": { "type": "object" },
    "references": { "type": "array", "items": { "$ref": "artifact-reference.v1.schema.json" } },
    "omitted": { "type": "array", "items": { "$ref": "#/$defs/omission" } },
    "stableDigest": { "$ref": "#/$defs/digest" },
    "deltaDigest": { "$ref": "#/$defs/digest" },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
