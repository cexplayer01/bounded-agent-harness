{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedagentharness.com/contracts/proof-observations.v1.schema.json",
  "title": "Bounded Agent Harness proof observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations"],
  "properties": { "schema_version": { "const": "bounded-agent-harness-proof-observations.v1" }, "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } } },
  "$defs": { "observation": { "type": "object", "additionalProperties": false, "required": ["id", "target", "observed_at", "reconciled_by", "deployment", "observed"], "properties": { "id": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1 }, "observed_at": { "type": "string", "format": "date-time" }, "reconciled_by": { "type": "string", "minLength": 1 }, "deployment": { "type": "object", "additionalProperties": false, "required": ["id", "rollback_id"], "properties": { "id": { "type": "string", "minLength": 1 }, "rollback_id": { "type": "string", "minLength": 1 } } }, "observed": { "type": "object" } } } }
}
