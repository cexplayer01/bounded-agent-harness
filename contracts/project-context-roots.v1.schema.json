{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedagentharness.com/contracts/project-context-roots.v1.schema.json",
  "title": "Bounded Agent Harness local repository roots v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "repositories"],
  "properties": {
    "format": { "const": "agent-harness.project-context-roots.v1" },
    "version": { "const": 1 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 101,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repositoryId", "rootPath"],
        "properties": {
          "repositoryId": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
          "rootPath": { "type": "string", "minLength": 1, "description": "Absolute local repository path. This machine-local mapping must not be committed or returned in a context packet." }
        }
      }
    }
  }
}
