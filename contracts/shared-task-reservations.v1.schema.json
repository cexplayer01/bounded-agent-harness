{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedagentharness.com/contracts/shared-task-reservations.v1.schema.json",
  "title": "Bounded Agent Harness shared task scope reservations",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "reservations", "ledgerDigest"],
  "properties": {
    "format": { "const": "agent-harness.shared-task-reservations.v1" },
    "version": { "const": 1 },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "taskDigest", "agentId", "allowedPaths", "claimedAt", "expiresAt"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$" },
          "taskDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,40}$" },
          "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "claimedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "ledgerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
