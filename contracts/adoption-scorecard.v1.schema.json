{
  "$id": "https://boundedagentharness.com/contracts/adoption-scorecard.v1.schema.json",
  "title": "Bounded Agent Harness adoption scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "reviewId", "reviewedAt", "reviewer", "comparisonSet", "rubric", "scores", "summary", "evidence", "digest"],
  "properties": {
    "format": { "const": "bounded-agent-harness-adoption-evaluation.v1" },
    "version": { "const": 1 },
    "reviewId": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "comparisonSet": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "evidenceUrl"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "evidenceUrl": { "type": "string", "format": "uri" } } } },
    "rubric": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "weight"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } } },
    "scores": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["systemId", "dimensions", "aggregate", "notes"], "properties": { "systemId": { "type": "string" }, "dimensions": { "type": "object", "additionalProperties": { "type": "number", "minimum": 1, "maximum": 10 } }, "aggregate": { "type": "number", "minimum": 1, "maximum": 10 }, "notes": {} } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["subjectAggregate", "comparatorMean", "relativeMargin", "subjectRank"], "properties": { "subjectAggregate": { "type": "number" }, "comparatorMean": { "type": "number" }, "relativeMargin": { "type": "number" }, "subjectRank": { "type": "integer", "minimum": 1 } } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
