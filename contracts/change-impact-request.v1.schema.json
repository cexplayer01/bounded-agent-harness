{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-harness/change-impact-request.v1.schema.json",
  "title": "Bounded change-impact request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "outcome", "change_kind", "changed_paths", "reference_tokens", "verification_catalog"],
  "properties": {
    "schema_version": { "const": "change-impact-request.v1" },
    "change_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "outcome": { "type": "string", "minLength": 1, "maxLength": 240 },
    "change_kind": { "enum": ["DOCUMENTATION", "LOCAL_IMPLEMENTATION", "PUBLIC_INTERFACE", "SCHEMA_OR_POLICY", "EXTERNAL_EFFECT_BOUNDARY"] },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "reference_tokens": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "verification_catalog": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/verification" }
    },
    "external_gates": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "ignored_prefixes": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))[^\\r\\n\\u0000]+$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\s\\u0000]+$" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tier", "command", "covers"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
        "tier": { "enum": ["TIER_0_STATIC", "TIER_1_DIRECT", "TIER_2_BOUNDARY", "TIER_3_FULL"] },
        "command": { "type": "string", "minLength": 1, "maxLength": 500 },
        "covers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
            "prefixes": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
            "tokens": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
            "global": { "type": "boolean" }
          },
          "anyOf": [
            { "required": ["paths"] },
            { "required": ["prefixes"] },
            { "required": ["tokens"] },
            { "properties": { "global": { "const": true } }, "required": ["global"] }
          ]
        }
      }
    }
  }
}
