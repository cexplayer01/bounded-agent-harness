{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedagentharness.com/contracts/project-context-packet.v1.schema.json",
  "title": "Bounded Agent Harness materialized project context packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "projectId", "status", "scopeDigest", "selected", "findings", "digest"],
  "properties": {
    "format": { "const": "agent-harness.project-context-packet.v1" },
    "version": { "const": 1 },
    "projectId": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
    "status": { "enum": ["READY", "BLOCKED"] },
    "scopeDigest": { "$ref": "#/$defs/digest" },
    "selected": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/source" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "repositoryId", "path", "locator", "purpose", "content", "contentDigest"],
      "properties": {
        "id": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
        "projectId": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
        "repositoryId": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
        "path": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/path" },
        "locator": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/locator" },
        "dependencyId": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
        "purpose": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/purpose" },
        "content": { "type": "string" },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "sourceId", "projectId", "repositoryId", "path"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" },
        "sourceId": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
        "projectId": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
        "repositoryId": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/id" },
        "path": { "$ref": "project-scope-manifest.v1.schema.json#/$defs/path" }
      }
    }
  }
}
